# ============================================================
# 后端环境变量示例文件（复制为 .env 后填入真实值）
# 真实 .env 文件已被 .gitignore 忽略，禁止提交到 git
# ============================================================

# 微信小程序配置
WX_APP_ID=
WX_APP_SECRET=

# 微信支付商户配置
WX_MCH_ID=
WX_API_V3_KEY=

# 微信支付回调域名（必须 https）
WX_NOTIFY_DOMAIN=

# MongoDB Atlas 连接串（包含用户名/密码）
MONGO_URI=

# 服务监听端口
PORT=3000
